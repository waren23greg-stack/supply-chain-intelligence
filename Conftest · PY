"""
pytest configuration.
In CI (APP_ENV=test), all OpenAI/LangChain LLM calls are automatically
mocked so tests run without a real API key.
"""
import os
import pytest
from unittest.mock import AsyncMock, MagicMock, patch


def pytest_configure(config):
    config.addinivalue_line(
        "markers", "llm: marks tests that make real LLM calls (skipped in CI)"
    )


@pytest.fixture(autouse=True)
def mock_llm_in_ci():
    """
    When APP_ENV=test, patch OpenAI so no real calls are made.
    Tag tests that need a real LLM with @pytest.mark.llm — CI skips them.
    """
    if os.getenv("APP_ENV") != "test":
        yield
        return

    fake_response = MagicMock()
    fake_response.choices = [
        MagicMock(message=MagicMock(content="mocked llm response"))
    ]

    with patch("openai.OpenAI") as mock_sync, \
         patch("openai.AsyncOpenAI") as mock_async:
        mock_sync.return_value.chat.completions.create.return_value = fake_response
        mock_async.return_value.chat.completions.create = AsyncMock(
            return_value=fake_response
        )
        yield


